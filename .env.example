# Supabase — Project Settings → API
# Used ONLY on the server, for storing "Request an Introduction" submissions.
# Without these set, the form returns a friendly error instead of silently
# dropping submissions. Run supabase/migrations/0002_introduction_requests.sql
# in the Supabase SQL editor before first use.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed site (used for sitemap/OG). Optional locally.
NEXT_PUBLIC_SITE_URL=https://investorsignals.co
