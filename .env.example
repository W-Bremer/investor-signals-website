# Delivery for "Request an Introduction" submissions. The API route emails
# each request to REQUEST_INBOX via Resend (resend.com, free tier is fine).
# Without these set, the form shows a clear error instead of silently
# dropping requests. No database is used anywhere on this site.

RESEND_API_KEY=re_your_api_key
REQUEST_INBOX=you@investorsignals.co
# Optional comma-separated CC on each request email.
# REQUEST_CC=someone@example.com

# Optional: a verified sender on your Resend account. Defaults to Resend's
# onboarding sender, which can only deliver to the Resend account owner.
# REQUEST_FROM="Investor Signals <requests@investorsignals.co>"

# Base URL of the deployed site (used for sitemap/OG). Optional locally.
NEXT_PUBLIC_SITE_URL=https://investorsignals.co

# Meta Lead Ads -> email (src/app/api/meta-leads). Meta POSTs each instant-form
# lead to /api/meta-leads; the route fetches it and emails LEAD_INBOXES (cc LEAD_CC) via
# Resend (same RESEND_API_KEY / REQUEST_FROM as above).
# META_ACCESS_TOKEN: system-user token from the Investor Signals business
# (ads + leads_retrieval). META_WEBHOOK_VERIFY_TOKEN: any random string, also
# entered in the Meta app's Webhooks settings. META_APP_SECRET is optional and
# enables signature checks on incoming webhooks.
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=
LEAD_INBOXES=bryce@investorsignals.co
LEAD_CC=williambremer9@gmail.com
